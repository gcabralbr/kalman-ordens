[Unit]
Description=kalman-ordens — ordens reais do Kalman no PnT (DSA, FIX 4.4)
Documentation=file:///opt/kalman-ordens/LEIA.md
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=kalman-ordens
Group=kalman-ordens
EnvironmentFile=/etc/kalman-ordens/service.env
ExecStart=/opt/kalman-ordens/kalman-ordens servir
WorkingDirectory=/var/lib/kalman-ordens
# Parar o processo faz logout FIX e NÃO cancela a 1014: a posição continua protegida no PnT.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# Arquivos novos só do usuário do serviço (o QuickFIX/Go cria o log com 0777 & ~umask): log e
# store FIX ficam 600, diretórios 700. O serviço também aperta o que já existia ao subir.
UMask=0077
StateDirectory=kalman-ordens
StateDirectoryMode=0700

# Endurecimento: só escreve em /var/lib/kalman-ordens (store e log FIX).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/kalman-ordens

[Install]
WantedBy=multi-user.target
