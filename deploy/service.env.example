# /etc/kalman-ordens/service.env — root:kalman-ordens, modo 640, FORA do repositório.
# Copiar este exemplo, preencher os segredos e conferir cada valor.

# ---------------- Banco (MariaDB 10.11 na .51) — schema próprio do serviço
DB_DSN=kalman_ordens:SENHA@tcp(127.0.0.1:3306)/kalmanordens

# ---------------- Sessão FIX própria (nunca a do PT) [PnT-1]
FIX_SENDER_COMP_ID=
FIX_TARGET_COMP_ID=PNT_DSA
FIX_HOST=
FIX_PORTA=
FIX_USUARIO=
FIX_SENHA=
FIX_DIR=/var/lib/kalman-ordens/fix
FIX_INICIO=08:30:00
FIX_FIM=17:55:00
FIX_HEARTBEAT=30
FIX_RECONEXAO_S=5
# espera crescente (FIX_RECONEXAO_S dobrando até aqui) depois de logon recusado pelo PnT ("already
# logged on") ou de store ilegível no reenvio (SPEC v1.3 B1, D1)
FIX_RECONEXAO_MAX_S=60
# depois do logon, espera antes de liberar o envio: o ResendRequest do PnT é atendido antes do
# mass status (SPEC v1.3 A2)
FIX_SINCRONIA_MS=500
# [PnT-11] só Y se o PnT exigir reset a cada logon
FIX_RESET_ON_LOGON=N

# ---------------- Identificação da ordem [PnT-3]
# v1.2: conta e destino vêm do usuário no GQ (dbecotools.acusuario), o símbolo do ticker do
# marketdata, a habilitação da CLI (kalman-ordens usuario habilitar). ORDENS_CONTA, ORDENS_ONBEHALF,
# ORDENS_SIMBOLO, ORDENS_VENCIMENTO e ORDENS_UID_REAL saíram: o serviço não sobe se estiverem aqui.
# Ambientes (SPEC-AMBIENTES-v1, v1.25): o ambiente do LOGIN do usuário no GQ vem em cada ordem
# (SIMULADOR lê usutxtconfig, REAL lê usutxtconfigprd); a máquina é só o teto.
#   AMBIENTES_PERMITIDOS=SIM (padrão), REAL ou SIM,REAL. O REAL só entra escrito, com
#   REAL_UIDS, REAL_CONTAS (lista ou *) e REAL_LIMITE_QTD_ORDEM, REAL_LIMITE_PERDA_DIA_PTS e
#   REAL_LIMITE_ENTRADAS_DIA (obrigatórias; REAL_LIMITE_POSICAO_MAX e REAL_LIMITE_ENTRADAS_MIN
#   opcionais) e um conector REAL (o bloco "Conectores do REAL" abaixo; sem nenhum, não sobe).
#   AMBIENTE_PADRAO=SIMULADOR: só na transição, para o pedido sem o campo ambiente.
# AMBIENTES_PERMITIDOS=SIM
# AMBIENTE_PADRAO=SIMULADOR
# Transição: ORDENS_AMBIENTE=HML equivale a AMBIENTES_PERMITIDOS=SIM + AMBIENTE_PADRAO=SIMULADOR
# (com o PnT também no SIMULADOR, como antes); PRODUCAO, ao REAL para todos. Não junto com
# AMBIENTES_PERMITIDOS (o serviço não sobe).
ORDENS_AMBIENTE=
# Contas de simulador do PnT: no SIMULADOR a conta do usuário TEM de estar aqui; no REAL NÃO pode.
ORDENS_CONTAS_HML=99999
ORDENS_BOLSA=BVMF
# 142 (SenderLocationID). Na HML do PT: 177.124.234.134
ORDENS_SENDER_LOCATION=

# ---------------- HTTP local (só loopback) e marketdata
HTTP_ENDERECO=127.0.0.1:9092
HTTP_ESPERA_S=5
PRECOS_URL=http://172.16.110.51:9090
PRECOS_ATIVO=WINFUT
# (v1.14) FONTE_DEGRADADA: fonte de preço ruim por mais de FONTE_DEGRADADA_S dentro da janela
FONTE_JANELA=09:00-18:25
FONTE_DEGRADADA_S=30
# só na .53 com o pnt-md-hml: o /saude dele dá o motivo no texto do alerta (vazio = desligado)
PRECOS_SAUDE_URL=

# ---------------- Telegram direto (sem intermediário)
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
# (v1.14) ou pelo bot local da máquina (GET ?msg=, o KALMAN_ALERT_WEBHOOK_URL do Kalman); vence o TELEGRAM_*
ALERTA_WEBHOOK_URL=
# a máquina no texto: "[<ALERTA_SERVIDOR> kalman-ordens] ..." (vazio = o hostname curto)
ALERTA_SERVIDOR=
# (v1.15) crítico: repete a cada ALERTA_REPETICAO_S (30) até ALERTA_REPETICAO_CURTA_S (120) da emissão;
# depois, a cada ALERTA_REPETICAO_LONGA_S (300)
ALERTA_REPETICAO_S=30
ALERTA_REPETICAO_CURTA_S=120
ALERTA_REPETICAO_LONGA_S=300

# ---------------- Execução (valores iniciais da SPEC; mudar só com motivo)
# COLAR_ENTRADA_PTS=15
# TIMEOUT_ENTRADA_S=3
# FOLGA_STOP_PTS=100
# AJUSTE_DEGRAU_MIN_PTS=25
# COLAR_SAIDA_PTS=50
# TIMEOUT_SAIDA_S=2
# MAX_REPRECO_SAIDA=3
# v1.18: saída em leilão (status84 != 0): limite N% sobre o último negócio, sem repreço até o leilão acabar
# SAIDA_LEILAO_PCT=10
# v1.11: saída que não é por stop pelo replace da 1014 (gatilho além do preço) em vez de cancel +
# 1031. Desligada por padrão; na HML (.53), SAIDA_POR_REPLACE=1. docs/TESTE-SAIDA-REPLACE.md.
# SAIDA_POR_REPLACE=0
# SAIDA_REPLACE_ALEM_PTS=100
# SAIDA_REPLACE_TIMEOUT_S=2
# v1.13: 20864=Y (IgnoreTunnel) vai sempre na 1014 e na saída; nas entradas, só com esta chave
# IGNORE_TUNNEL_ENTRADA=0
# v1.13: MaxReplaces da 1014 (RoE, padrão 100) e a reserva para a saída por replace
# REPLACES_1014_MAX=100
# REPLACES_1014_RESERVA=5
# Disjuntor de bolsa indisponível (SPEC v1.10 §9)
# DISJUNTOR_TEXTOS=Exchange is offline   # textos (separados por |) que abrem o estado na hora
# DISJUNTOR_REJEICOES=5                  # ou N rejeições iguais (saída/1014/cancel/replace) em
# DISJUNTOR_JANELA_S=30                  #   X s
# DISJUNTOR_SONDA_S=30                   # uma sonda (a primeira retida, 1014 antes) a cada 30 s
# DISJUNTOR_ESTAVEL_S=60                 # entradas novas só 60 s depois da volta, sem rejeição
# REPRECO_ESGOTADO_S=10   # depois de SAIDA_ESGOTOU, o repreço passa a cada 10 s (o alerta crítico continua)
# ESPERA_STOP_S=5
# ESPERA_ERRO_S=2
# CONFERE_CONTA_S=60
# PRAZO_CONFIRMACAO_S=3
# ESPERA_ENCERRAMENTO_S=8
# ESPERA_FILL_POS_RECUSA_S=3
# SESSAO_PRESA_ALERTA_S=60
# IDADE_MAX_PRECO_DIVERGENTE_S=60
# CONSULTA_PNT_ESPERA_S=5
# CONSULTA_PNT_INTERVALO_S=10
# FIX_TAXA_MSG_S=100        # limitador de taxa da sessão (só a entrada espera); conservador até [PnT-19]
# FIX_RAJADA_MSG=100
# FIX_RESERVA_SAIDA_MSG_S=30  # da taxa, reservado a 1014/cancel/saída; o balde da entrada enche a 100-30=70/s
# ENTRADA_TTL_FILA_S=5      # entrada que não saiu em 5 s é descartada (EXPIRADA_NA_FILA)
# MASS_STATUS_ESPERA_MAX_S=30  # conciliação com 911/912: espera máxima pelas contas
# SINAL_ESPERA_PARTES_MS=500  # POST /sinais: o sinal em partes fecha 500 ms depois da primeira (ou com todas)
# SINAL_MAX_ITENS_PARTE=1000
# SINAL_MAX_PARTES=10
# CACHE_USUARIOS_S=30       # a CLI usuario grava direto no banco: o efeito chega em até 30 s
# FIX_STORE_SYNC=Y          # fsync do store FIX a cada mensagem (docs/CARGA-2026-10-15.md 7.2)

# ---------------- Limites (Parte 5)
# Globais (soma de todos os usuários; padrões da v1.10 para rajadas de 190 usuários)
# LIMITE_POSICAO_MAX=200
# LIMITE_QTD_ORDEM=1
# LIMITE_INTERVALO_ENTRADAS_S=0     # entre duas entradas de qualquer usuário (0 = desligado)
# LIMITE_ENTRADAS_MIN=400
# LIMITE_MENSAGENS_MIN=3000         # recusa só entradas, nunca saídas
# LIMITE_ENTRADAS_DIA=3000
# LIMITE_PERDA_DIA_PTS=1500         # resultado do dia somando todos os usuários
# LIMITE_BOOK_DESCOLADO_PTS=150
# LIMITE_RECUSAS_PARADA=50          # recusas por limite global em 1 min → parada BLOQUEAR
# Por usuário (v1.10 L): o laço de reentrada de um uid; não contam para a parada
# LIMITE_ENTRADAS_MIN_UID=3
# LIMITE_INTERVALO_UID_S=30         # entre duas entradas do uid no MESMO sentido
# LIMITE_VIRADA_S=10                # virada de mão: entrada oposta até 10 s depois de ZERADA por SINAL_OPOSTO não passa pelos dois acima
# JANELA_INICIO=09:00:00
# JANELA_FIM=14:00:00
# HORA_ZERAGEM=14:30:00

# ---------------- Conector Flexscan (SPEC-FLEXSCAN-v1; sem FLEXSCAN_URL, uid habilitado na Flexscan é recusado)
# O conector vem da habilitação (um por uid), não da corretora do GQ:
#   kalman-ordens usuario habilitar -uid N -conectores flexscan -motivo X
# FLEXSCAN_URL=https://apisim.flexscan.com.br/v1
# FLEXSCAN_USUARIO=
# FLEXSCAN_SENHA=
# FLEXSCAN_CONTAS_HML=S-1117150        # contas de simulador da Flexscan: a trava por ambiente (como o ORDENS_CONTAS_HML)
# FLEXSCAN_BOLSA=XBMF
# Webhook (listener próprio, só a rota POST <prefixo><segredo>; o admin continua só no loopback):
# FLEXSCAN_WEBHOOK_ENDERECO=172.16.110.53:9098
# FLEXSCAN_WEBHOOK_SEGREDO=            # >= 32 caracteres, base64url (openssl rand -base64 33 | tr '+/' '-_' | tr -d '=')
# FLEXSCAN_WEBHOOK_PREFIXO=/flexscan/webhook/
# FLEXSCAN_CONFIRMAR_FILL=1            # fill espontâneo de limite pelo webhook só vale depois da consulta
# FLEXSCAN_TIMEOUT_MS=3000
# FLEXSCAN_REQ_POR_S=10                # até a Flexscan dizer o limite dela [FX-1]
# FLEXSCAN_CONFIRMA_S=5                # janela da consulta ativa depois de uma ação
# FLEXSCAN_CONSULTA_S=5                # consulta periódica das ordens vivas
# FLEXSCAN_RENOVAR_ANTES_MIN=30        # renova o token antes do exp do JWT
# FLEXSCAN_ESPERA_LOGIN_S=30           # entre logins que falharam
# FLEXSCAN_ESTADO_LOGIN=/var/lib/kalman-ordens/flexscan-login.json  # limite de logins entre restarts
# FLEXSCAN_LOGIN_MAX=5                 # logins em FLEXSCAN_LOGIN_JANELA_MIN (contando os restarts)
# FLEXSCAN_LOGIN_JANELA_MIN=10
# Fonte de preço por conector: PRECOS_URL é o padrão; PRECOS_URL_<CONECTOR> só onde difere
# (na .53: PnT pela HML D-1 no 9096, Flexscan pelo mercado de hoje no 9090 da principal)
# PRECOS_URL_FLEXSCAN=http://172.16.110.53:9090
# PRECOS_SAUDE_URL_FLEXSCAN=
# v1.21: a URL pública do webhook, como cadastrada na Flexscan (com o segredo; nunca vai a log,
# tráfego ou alerta). Com ela, o serviço confere o cadastro (GET /webhooks) na partida e a cada
# FLEXSCAN_WEBHOOK_CONFERIR_MIN e recadastra se faltar (FLEXSCAN_WEBHOOK_AUSENTE, crítico). Vazia = não confere.
# FLEXSCAN_WEBHOOK_URL=https://<host público>/flexscan/webhook/<segredo>
# FLEXSCAN_WEBHOOK_CONFERIR_MIN=10
# FLEXSCAN_PRIMEIRA_CONSULTA_MS=200      # a 1ª consulta depois do 202 do POST (o 404 "Order not found" logo depois)
# FLEXSCAN_WEBHOOK_ESPERA_S=5           # v1.22: o webhook da ordem depois de um 202 nosso ou de uma mudança vista pela consulta; 0 = não espera
# v1.28: a agenda da Flexscan (dias de pregão, pelos feriados de FERIADOS_ARQ). Dentro da janela, a
# conferência do webhook a cada FLEXSCAN_WEBHOOK_CONFERIR_MIN e a renovação do token antes de vencer;
# fora dela, nenhuma chamada à Flexscan, a não ser com operação viva da Flexscan (aí tudo continua,
# por segurança) ou num envio do serviço (saída, ação do admin: loga na hora). O token que vence fora
# da janela não é renovado: a ponte fica sem sessão, sem alerta, e loga de novo no início da janela.
# FLEXSCAN_RENOVAR_ABERTURA: uma renovação por dia, se o token não chega ao fim da janela (um login
# feito a partir do início da janela já conta). FLEXSCAN_CONFERIR_ABERTURA: a conferência obrigatória
# antes da abertura (pega a limpeza noturna da Flexscan, ~03:45). FLEXSCAN_JANELA=sempre: como antes.
# No /saude.flexscan: janela, ativa, ativa_por, dormindo. No REAL, REAL_FLEXSCAN_JANELA etc. se diferir.
# FLEXSCAN_JANELA=08:00-18:30
# FLEXSCAN_RENOVAR_ABERTURA=08:15
# FLEXSCAN_CONFERIR_ABERTURA=08:30

# ---------------- PnT desligado (SPEC v1.19.1, 28/10: só a Flexscan)
# PNT_DESLIGADO=1: não cria a sessão FIX (as chaves FIX_* e ORDENS_CONTAS_HML deixam de ser
# obrigatórias e são ignoradas), não lê a fonte do PnT (a fonte única é PRECOS_URL_FLEXSCAN, ou
# PRECOS_URL sem ela, com PRECOS_SAUDE_URL_FLEXSCAN), recusa a entrada de uid PNT
# (CONECTOR_DESLIGADO). Exige FLEXSCAN_URL. No /saude: sessao_logada false, pnt_desligado true.
# PNT_DESLIGADO=1

# FERIADOS_ARQ=/var/lib/kalman/feriados.json   # a janela do FONTE_DEGRADADA só em dia de pregão (24/10)

# ---------------- Conectores do REAL (SPEC-AMBIENTES-v1 §10, v1.26)
# Com AMBIENTES_PERMITIDOS=SIM,REAL (sem ORDENS_AMBIENTE), cada ambiente é uma instância do motor com
# os seus conectores. As chaves sem prefixo são as do SIMULADOR; as do REAL são as REAL_ e NUNCA caem
# nas sem prefixo (credencial de um ambiente não vale no outro). No SIMULADOR as FIX_* são ignoradas:
# o PnT só opera no REAL.
# REAL_UIDS=5725
# REAL_CONTAS=715124
# REAL_LIMITE_QTD_ORDEM=1
# REAL_LIMITE_PERDA_DIA_PTS=300
# REAL_LIMITE_ENTRADAS_DIA=10
# Flexscan de produção: usuário de API dedicado ao kalman-ordens, nunca usado para logar no GQ (D4)
# REAL_FLEXSCAN_URL=
# REAL_FLEXSCAN_USUARIO=
# REAL_FLEXSCAN_SENHA=
# REAL_FLEXSCAN_WEBHOOK_SEGREDO=          # >= 32 caracteres, outro que o do SIMULADOR
# REAL_FLEXSCAN_WEBHOOK_PREFIXO=/flexscan/webhook-real/   # o mesmo listener (FLEXSCAN_WEBHOOK_ENDERECO), outra rota
# REAL_FLEXSCAN_WEBHOOK_URL=https://<host público>/flexscan/webhook-real/<segredo>
# REAL_FLEXSCAN_ESTADO_LOGIN=/var/lib/kalman-ordens/flexscan-login-real.json
# PnT de produção (a sessão FIX só existe no REAL); REAL_PNT_DESLIGADO=1 a desliga
# REAL_FIX_SENDER_COMP_ID=
# REAL_FIX_TARGET_COMP_ID=PNT_DSA
# REAL_FIX_HOST=
# REAL_FIX_PORTA=
# REAL_FIX_USUARIO=
# REAL_FIX_SENHA=
# REAL_FIX_DIR=/var/lib/kalman-ordens/fix-real
# REAL_FIX_INICIO=08:30:00
# REAL_FIX_FIM=17:55:00
# Opcionais (sem elas, as sem prefixo): REAL_ORDENS_BOLSA, REAL_ORDENS_SENDER_LOCATION,
# REAL_FLEXSCAN_BOLSA, REAL_PRECOS_URL_FLEXSCAN, REAL_PRECOS_SAUDE_URL_FLEXSCAN, REAL_PRECOS_URL_PNT,
# REAL_PRECOS_SAUDE_URL_PNT
