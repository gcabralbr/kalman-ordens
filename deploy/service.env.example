# /etc/kalman-ordens/service.env — root:kalman-ordens, modo 640, FORA do repositório.
# Copiar este exemplo, preencher os segredos e conferir cada valor.

# ---------------- Banco (MariaDB 10.11 na .51) — schema próprio do serviço
DB_DSN=kalman_ordens:SENHA@tcp(127.0.0.1:3306)/kalmanordens

# ---------------- Sessão FIX própria (nunca a do PT) [PnT-1]
FIX_SENDER_COMP_ID=
FIX_TARGET_COMP_ID=PNT_DSA
FIX_HOST=
FIX_PORTA=
FIX_USUARIO=
FIX_SENHA=
FIX_DIR=/var/lib/kalman-ordens/fix
FIX_INICIO=08:30:00
FIX_FIM=17:55:00
FIX_HEARTBEAT=30
FIX_RECONEXAO_S=5
# espera crescente (FIX_RECONEXAO_S dobrando até aqui) depois de logon recusado pelo PnT ("already
# logged on") ou de store ilegível no reenvio (SPEC v1.3 B1, D1)
FIX_RECONEXAO_MAX_S=60
# depois do logon, espera antes de liberar o envio: o ResendRequest do PnT é atendido antes do
# mass status (SPEC v1.3 A2)
FIX_SINCRONIA_MS=500
# [PnT-11] só Y se o PnT exigir reset a cada logon
FIX_RESET_ON_LOGON=N

# ---------------- Identificação da ordem [PnT-3]
# v1.2: conta e destino vêm do usuário no GQ (dbecotools.acusuario), o símbolo do ticker do
# marketdata, a habilitação da CLI (kalman-ordens usuario habilitar). ORDENS_CONTA, ORDENS_ONBEHALF,
# ORDENS_SIMBOLO, ORDENS_VENCIMENTO e ORDENS_UID_REAL saíram: o serviço não sobe se estiverem aqui.
# HML lê usutxtconfig (simulação); PRODUCAO lê usutxtconfigprd (conta real).
ORDENS_AMBIENTE=
# Contas de HML. Em HML a conta do usuário TEM de estar aqui; em PRODUCAO NÃO pode estar.
ORDENS_CONTAS_HML=99999
ORDENS_BOLSA=BVMF
# 142 (SenderLocationID). Na HML do PT: 177.124.234.134
ORDENS_SENDER_LOCATION=

# ---------------- HTTP local (só loopback) e marketdata
HTTP_ENDERECO=127.0.0.1:9092
HTTP_ESPERA_S=5
PRECOS_URL=http://172.16.110.51:9090
PRECOS_ATIVO=WINFUT
# (v1.14) FONTE_DEGRADADA: fonte de preço ruim por mais de FONTE_DEGRADADA_S dentro da janela
FONTE_JANELA=09:00-18:25
FONTE_DEGRADADA_S=30
# só na .53 com o pnt-md-hml: o /saude dele dá o motivo no texto do alerta (vazio = desligado)
PRECOS_SAUDE_URL=

# ---------------- Telegram direto (sem intermediário)
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
# (v1.14) ou pelo bot local da máquina (GET ?msg=, o KALMAN_ALERT_WEBHOOK_URL do Kalman); vence o TELEGRAM_*
ALERTA_WEBHOOK_URL=
# a máquina no texto: "[<ALERTA_SERVIDOR> kalman-ordens] ..." (vazio = o hostname curto)
ALERTA_SERVIDOR=

# ---------------- Execução (valores iniciais da SPEC; mudar só com motivo)
# COLAR_ENTRADA_PTS=15
# TIMEOUT_ENTRADA_S=3
# FOLGA_STOP_PTS=100
# AJUSTE_DEGRAU_MIN_PTS=25
# COLAR_SAIDA_PTS=50
# TIMEOUT_SAIDA_S=2
# MAX_REPRECO_SAIDA=3
# v1.11: saída que não é por stop pelo replace da 1014 (gatilho além do preço) em vez de cancel +
# 1031. Desligada por padrão; na HML (.53), SAIDA_POR_REPLACE=1. docs/TESTE-SAIDA-REPLACE.md.
# SAIDA_POR_REPLACE=0
# SAIDA_REPLACE_ALEM_PTS=100
# SAIDA_REPLACE_TIMEOUT_S=2
# v1.13: 20864=Y (IgnoreTunnel) vai sempre na 1014 e na saída; nas entradas, só com esta chave
# IGNORE_TUNNEL_ENTRADA=0
# v1.13: MaxReplaces da 1014 (RoE, padrão 100) e a reserva para a saída por replace
# REPLACES_1014_MAX=100
# REPLACES_1014_RESERVA=5
# Disjuntor de bolsa indisponível (SPEC v1.10 §9)
# DISJUNTOR_TEXTOS=Exchange is offline   # textos (separados por |) que abrem o estado na hora
# DISJUNTOR_REJEICOES=5                  # ou N rejeições iguais (saída/1014/cancel/replace) em
# DISJUNTOR_JANELA_S=30                  #   X s
# DISJUNTOR_SONDA_S=30                   # uma sonda (a primeira retida, 1014 antes) a cada 30 s
# DISJUNTOR_ESTAVEL_S=60                 # entradas novas só 60 s depois da volta, sem rejeição
# REPRECO_ESGOTADO_S=10   # depois de SAIDA_ESGOTOU, o repreço passa a cada 10 s (o alerta crítico continua)
# ESPERA_STOP_S=5
# ESPERA_ERRO_S=2
# CONFERE_CONTA_S=60
# PRAZO_CONFIRMACAO_S=3
# ESPERA_ENCERRAMENTO_S=8
# ESPERA_FILL_POS_RECUSA_S=3
# SESSAO_PRESA_ALERTA_S=60
# IDADE_MAX_PRECO_DIVERGENTE_S=60
# CONSULTA_PNT_ESPERA_S=5
# CONSULTA_PNT_INTERVALO_S=10
# FIX_TAXA_MSG_S=100        # limitador de taxa da sessão (só a entrada espera); conservador até [PnT-19]
# FIX_RAJADA_MSG=100
# FIX_RESERVA_SAIDA_MSG_S=30  # da taxa, reservado a 1014/cancel/saída; o balde da entrada enche a 100-30=70/s
# ENTRADA_TTL_FILA_S=5      # entrada que não saiu em 5 s é descartada (EXPIRADA_NA_FILA)
# MASS_STATUS_ESPERA_MAX_S=30  # conciliação com 911/912: espera máxima pelas contas
# SINAL_ESPERA_PARTES_MS=500  # POST /sinais: o sinal em partes fecha 500 ms depois da primeira (ou com todas)
# SINAL_MAX_ITENS_PARTE=1000
# SINAL_MAX_PARTES=10
# CACHE_USUARIOS_S=30       # a CLI usuario grava direto no banco: o efeito chega em até 30 s
# FIX_STORE_SYNC=Y          # fsync do store FIX a cada mensagem (docs/CARGA-2026-10-15.md 7.2)

# ---------------- Limites (Parte 5)
# Globais (soma de todos os usuários; padrões da v1.10 para rajadas de 190 usuários)
# LIMITE_POSICAO_MAX=200
# LIMITE_QTD_ORDEM=1
# LIMITE_INTERVALO_ENTRADAS_S=0     # entre duas entradas de qualquer usuário (0 = desligado)
# LIMITE_ENTRADAS_MIN=400
# LIMITE_MENSAGENS_MIN=3000         # recusa só entradas, nunca saídas
# LIMITE_ENTRADAS_DIA=3000
# LIMITE_PERDA_DIA_PTS=1500         # resultado do dia somando todos os usuários
# LIMITE_BOOK_DESCOLADO_PTS=150
# LIMITE_RECUSAS_PARADA=50          # recusas por limite global em 1 min → parada BLOQUEAR
# Por usuário (v1.10 L): o laço de reentrada de um uid; não contam para a parada
# LIMITE_ENTRADAS_MIN_UID=3
# LIMITE_INTERVALO_UID_S=30         # entre duas entradas do uid no MESMO sentido
# LIMITE_VIRADA_S=10                # virada de mão: entrada oposta até 10 s depois de ZERADA por SINAL_OPOSTO não passa pelos dois acima
# JANELA_INICIO=09:00:00
# JANELA_FIM=14:00:00
# HORA_ZERAGEM=14:30:00
