# /etc/kalman-ordens/disco.env — root:root 600. Monitor de disco da .53 (deploy/disco-alerta.sh).
# Envio (também do kalman-pnt-md-hml-parada): o bot local da .53 (GET ?msg=); vazio = Telegram direto
# pelo TELEGRAM_TOKEN/TELEGRAM_CHAT; os três vazios = alertas só no journal.
ALERTA_WEBHOOK_URL=http://127.0.0.1:5077/telegram/send_alert?chat_id=689010169
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
# a máquina no texto: "[.53 kalman-disco-alerta] ..."
ALERTA_SERVIDOR=.53
DISCO_PONTOS="/ /home"
DISCO_AVISO=80
DISCO_CRITICO=90
DISCO_REPETIR_MIN=30
