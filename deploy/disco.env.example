# /etc/kalman-ordens/disco.env — root:root 600. Monitor de disco da .53 (deploy/disco-alerta.sh).
# Telegram: o chat da .53 (separado do de produção). Vazio = alertas só no journal.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
DISCO_PONTOS="/ /home"
DISCO_AVISO=80
DISCO_CRITICO=90
DISCO_REPETIR_MIN=30
DISCO_ROTULO=kalman-53
