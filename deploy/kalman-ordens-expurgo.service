[Unit]
Description=kalman-ordens — expurgo mensal (mensagens FIX, eventos, sessão e pedidos além da retenção)
Documentation=file:///opt/kalman-ordens/LEIA.md
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=kalman-ordens
Group=kalman-ordens
# EXPURGO_DB_DSN (usuário de banco só do expurgo, DELETE só nas tabelas com retenção) e EXPURGO_MESES
EnvironmentFile=/etc/kalman-ordens/expurgo.env
ExecStart=/opt/kalman-ordens/kalman-ordens expurgar

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
