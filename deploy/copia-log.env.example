# /etc/kalman-ordens/copia-log.env — root:root 600. Na .51 (F2): cópia diária do log FIX para a .53.
# Destino: a conta da .53 cuja authorized_keys restringe esta chave ao rrsync num diretório
# (deploy/LEIA.md 5.3). O ":" no fim = o diretório que o rrsync permite.
COPIA_DESTINO=kalmancopia@172.16.110.53:
COPIA_ORIGEM=/var/lib/kalman-ordens/fix/log
COPIA_CHAVE=/etc/kalman-ordens/copia-log_ed25519
COPIA_KNOWN_HOSTS=/etc/kalman-ordens/copia-log_known_hosts
