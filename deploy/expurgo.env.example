# /etc/kalman-ordens/expurgo.env — root:root 600 (o systemd lê como root e passa ao processo)
# Usuário de banco SÓ do expurgo (deploy/LEIA.md 5.1): DELETE só nas quatro tabelas com retenção.
EXPURGO_DB_DSN=kalman_ordens_expurgo:<senha>@tcp(127.0.0.1:3306)/kalmanordens
# Retenção do banco em meses (mínimo 3). Aprovado: 12; sobe se o BTG exigir.
EXPURGO_MESES=12
