cenario 133 v1.35 (SPEC-TECNICA-REAL-PELA-TELA-F1 §3 e §4): a conta trocada no GQ SEM aprovação, COM posição aberta no REAL — o uid vai para CONTA_DIVERGENTE com o crítico (aprovado × atual e a posição), as entradas novas são recusadas e a 1014, o ajuste da stop, a 1014 recriada, o cancelamento e a saída continuam na conta gravada na operação; o cadastro de volta ao aprovado volta a APROVADO sozinho, com o RESOLVIDO
hora 2026-11-17 10:00:00
config ORDENS_AMBIENTE=
config ORDENS_CONTAS_HML=
config AMBIENTES_PERMITIDOS=REAL
config REAL_FIX_HOST=pnt-falso
config REAL_LIMITE_QTD_ORDEM=1
config REAL_LIMITE_POSICAO_MAX=1
config REAL_LIMITE_PERDA_DIA_PTS=600
config REAL_LIMITE_ENTRADAS_DIA=30
config LIMITE_INTERVALO_ENTRADAS_S=0
# uid 7 aprovado no REAL pelo PnT na conta 12345 (a do cadastro do GQ)
usuario 7 prd {"Robo":{"Conector":"PNT","CORSeqId":85,"CCONroConta":"12345"}}
aprova 7 conta=12345 corretora=85 conector=pnt

preco ticker=WINZ26 bid=130000 ask=130005 preco=130000 status84=0 idade=100ms
aguarda_logon
avanca 3s
alerta CONCILIACAO

# --- a posição aberta na conta aprovada
entrada 13301 C ambiente=REAL
resposta aceito=true ambiente=REAL
recebe 35=D 11=KM-E-13301-1 1=12345 116=12345 38=1 40=2 44=130020 54=1 847=1031
envia @ER 11=KM-E-13301-1 37=dsa.13301 150=0 39=0 54=1 38=1 44=130020 847=1031 14=0 151=1 6=0
envia @ER 11=KM-E-13301-1 37=dsa.13301 150=F 39=2 54=1 38=1 44=130020 847=1031 32=1 31=130010 14=1 151=0 6=130010
evento ENTRADA_EXECUTADA operacao_id=13301 qtd=1 preco=130010
recebe 35=D 11=KM-P-13301-1 1=12345 116=12345 38=1 54=2 847=1014 20828=129510 20829=129410
envia @ER 11=KM-P-13301-1 37=dsa.13301.P 150=0 39=0 54=2 38=1 44=129410 847=1014 14=0 151=1 6=0
evento PROTEGIDA operacao_id=13301 preco_stop=129510
saude posicao=1

# --- o usuário troca a conta no GQ e ninguém aprova: a próxima volta do avaliador (30 s) grava
# CONTA_DIVERGENTE e abre o crítico com aprovado × atual e a posição, que segue na conta 12345
gq 7 prd {"Robo":{"Conector":"PNT","CORSeqId":85,"CCONroConta":"7654321"}}
avanca 31s
evento ALERTA codigo=REAL_CONTA_DIVERGENTE "texto=uid 7: cadastro do GQ diferente do aprovado. Aprovado PNT / BTG (85) / conta 12345; atual PNT / BTG (85) / conta 7654321. Entradas novas recusadas ate nova aprovacao (ou o cadastro voltar). Posicao aberta: 1 WINZ26 na operacao 13301, segue na conta 12345 (stop 129510 viva)."
http GET /usuarios/7/habilitacao?ambiente=REAL
resposta habilitado=false
http GET /usuarios/7/destino?ambiente=REAL
resposta ambientes.REAL.pode_enviar=false ambientes.REAL.codigo=REAL_CONTA_DIVERGENTE

# --- a entrada nova é recusada (pelo estado gravado, antes de qualquer outra conferência)
entrada 13302 C ambiente=REAL
resposta aceito=false codigo=REAL_CONTA_DIVERGENTE "motivo=~aprovada PNT / BTG (85) / conta 12345, atual PNT / BTG (85) / conta 7654321"
alerta REAL_RECUSA_ESTADO
nada 35=D

# --- a operação aberta continua inteira na conta gravada: o ajuste da stop (35=G) ...
stop 13301 preco=129800
resposta aceito=true situacao=ENVIADO preco_stop=129800 preco_limite=129700
recebe 35=G 11=KM-P-13301-2 41=KM-P-13301-1 1=12345 116=12345 38=1 44=129700 54=2 847=1014 20828=129800 20829=129700
envia @ER 11=KM-P-13301-2 41=KM-P-13301-1 37=dsa.13301.P 150=5 39=5 54=2 38=1 44=129700 847=1014 14=0 151=1 6=0 20828=129800 20829=129700
evento PROTECAO_AJUSTADA operacao_id=13301 preco_stop=129800

# ... a 1014 cancelada pelo PnT e recriada (35=D) ...
envia @ER 11=KM-P-13301-2 37=dsa.13301.P 150=4 39=4 54=2 38=1 44=129700 847=1014 14=0 151=0 6=0 58="Order cancelled by the system"
recebe 35=D 11=KM-P-13301-3 1=12345 116=12345 38=1 54=2 847=1014 20828=129800 20829=129700
alerta PROTECAO_RECRIADA
envia @ER 11=KM-P-13301-3 37=dsa.13301.P3 150=0 39=0 54=2 38=1 44=129700 847=1014 14=0 151=1 6=0
evento PROTEGIDA operacao_id=13301 preco_stop=129800

# ... e a saída: o cancelamento da 1014 (35=F) e a ordem de saída (35=D), as duas na 12345
preco bid=130100 ask=130105 preco=130100
saida 13301 V SINAL_OPOSTO ambiente=REAL
resposta aceito=true
recebe 35=F 11=KM-P-13301-4 41=KM-P-13301-3 1=12345 116=12345
envia @ER 11=KM-P-13301-4 41=KM-P-13301-3 37=dsa.13301.P3 150=4 39=4 54=2 38=1 44=129700 847=1014 14=0 151=0 6=0
recebe 35=D 11=KM-S-13301-1 1=12345 116=12345 38=1 54=2 847=1031
envia @ER 11=KM-S-13301-1 37=dsa.13301.S 150=0 39=0 54=2 38=1 44=130050 847=1031 14=0 151=1 6=0
envia @ER 11=KM-S-13301-1 37=dsa.13301.S 150=F 39=2 54=2 38=1 44=130050 847=1031 32=1 31=130100 14=1 151=0 6=130100
evento ZERADA operacao_id=13301 pnl_pts=90
http GET /ordens/13301
resposta conta=12345 estado=ZERADA
# no REAL, o CONTA_ALTERADA_COM_POSICAO não sai: o REAL_CONTA_DIVERGENTE já trouxe a posição
sem_alerta CONTA_ALTERADA_COM_POSICAO

# --- o usuário volta o cadastro ao aprovado: APROVADO sozinho, com o RESOLVIDO; a entrada passa
gq 7 prd {"Robo":{"Conector":"PNT","CORSeqId":85,"CCONroConta":"12345"}}
avanca 31s
evento ALERTA codigo=RESOLVIDO "texto=REAL_CONTA_DIVERGENTE: REAL_CONTA_DIVERGENTE:7"
http GET /usuarios/7/habilitacao?ambiente=REAL
resposta habilitado=true
entrada 13303 C ambiente=REAL
resposta aceito=true
recebe 35=D 11=KM-E-13303-1 1=12345 116=12345 847=1031
