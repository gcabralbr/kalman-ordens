cenario 85 Disjuntor aberto sem nada a sondar: uma entrada a cada 30 s sai como sonda; o aceite limpo fecha o estado
hora 2026-10-16 13:10:00
# SPEC v1.10 §9 (16/10 13:09: o estado reabriu sem saída nem 1014 pendente e não fechava mais).
# Sem nada retido, no máximo uma entrada a cada DISJUNTOR_SONDA_S sai como sonda: rejeitada, segue o
# fluxo da recusa do PnT; aceita limpa, fecha o estado. As demais: PNT_BOLSA_INDISPONIVEL, e depois
# da volta DISJUNTOR_ESTAVEL_S.
config LIMITE_POSICAO_MAX=10
config LIMITE_INTERVALO_ENTRADAS_S=0
config LIMITE_ENTRADAS_MIN=10
config LIMITE_MENSAGENS_MIN=1000
config DISJUNTOR_SONDA_S=30
config DISJUNTOR_ESTAVEL_S=60
config TIMEOUT_ENTRADA_S=600

executa INICIO
# a bolsa cai numa entrada: o estado abre, a entrada é rejeitada, nada fica pendente
entrada 8501 C
resposta aceito=true
recebe 35=D 11=KM-E-8501-1 847=1031
envia @ER 11=KM-E-8501-1 37=dsa.8501.E 150=8 39=8 54=1 38=1 44=130020 847=1031 14=0 151=0 6=0 58="Real Order Rejected! Error: Exchange is offline. Try again later."
alerta PNT_BOLSA_INDISPONIVEL
evento ENTRADA_ENCERRADA operacao_id=8501 qtd_final=0
entrada 8502 C
resposta aceito=false codigo=PNT_BOLSA_INDISPONIVEL
# 30 s depois, uma entrada sai como sonda; ainda rejeitada, o estado segue
avanca 30s
entrada 8503 C
resposta aceito=true
recebe 35=D 11=KM-E-8503-1 847=1031
envia @ER 11=KM-E-8503-1 37=dsa.8503.E 150=8 39=8 54=1 38=1 44=130020 847=1031 14=0 151=0 6=0 58="Real Order Rejected! Error: Exchange is offline. Try again later."
entrada 8504 C
resposta aceito=false codigo=PNT_BOLSA_INDISPONIVEL
metrica kalman_ordens_disjuntor_bolsa_total evento=sonda_entrada >= 1
# mais 30 s: a próxima sonda é aceita limpa e fecha o estado
avanca 30s
entrada 8505 C
resposta aceito=true
recebe 35=D 11=KM-E-8505-1 847=1031
envia @ER 11=KM-E-8505-1 37=dsa.8505.E 150=0 39=0 54=1 38=1 44=130020 847=1031 14=0 151=1 6=0
alerta RESOLVIDO
http GET /sessao/ao-vivo?desde=0&limite=1
resposta saude.bolsa_indisponivel_desde=null
# as demais esperam DISJUNTOR_ESTAVEL_S
entrada 8506 C
resposta aceito=false codigo=PNT_BOLSA_INDISPONIVEL
avanca 60s
entrada 8507 C
resposta aceito=true
recebe 35=D 11=KM-E-8507-1 847=1031
envia @ER 11=KM-E-8507-1 37=dsa.8507.E 150=0 39=0 54=1 38=1 44=130020 847=1031 14=0 151=1 6=0
