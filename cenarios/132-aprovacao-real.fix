cenario 132 v1.35 (SPEC-TECNICA-REAL-PELA-TELA-F1 §5; v1.36: SPEC-TECNICA-v1.36-CONTA-LIVRE §5): as rotas da aprovação do REAL com o REAL fora de AMBIENTES_PERMITIDOS (a aceitação fora do pregão) — a ficha e a lista (v1.36: sem conta e sem limites aprovados; o cadastro do GQ só como informação, pelas regras do env, com a causa quando o sistema não o atende), as ações do admin com as recusas (campos, versão, transição inválida; a ação limites saiu), o corpo das telas F1 (visto e limites aceitos e ignorados), o GQ trocado durante o bloqueio sem efeito, o aprovar com o cadastro inutilizável aceito com o aviso, o CONTA_DIVERGENTE que sobrar valendo como APROVADO, o histórico, a rota antiga e a stop sem a instância; com o REAL desligado o verificador não roda (nenhum alerta)
hora 2026-11-17 18:40:00
config ORDENS_AMBIENTE=
config ORDENS_CONTAS_HML=
config AMBIENTES_PERMITIDOS=SIM
# a máquina atenderia o PnT no REAL (a ficha confere o cadastro pelas regras do env)
config REAL_FIX_HOST=pnt-falso
usuario 1450 prd {"Robo":{"Conector":"PNT","CORSeqId":85,"CCONroConta":"4582351"}}

avanca 1s

# --- sem aprovação: a lista vazia e a ficha com o GQ lido agora
http GET /usuarios/real
resposta _status=200 usuarios.#=0
http GET /usuarios/1450/real
resposta _status=200 uid=1450 estado=SEM_APROVACAO versao=0 aprovado=null ultima_mudanca=null divergencia=null acoes.#=1 acoes.0=aprovar historico.#=0
resposta gq.conector=PNT gq.corretora_codigo=85 gq.corretora=BTG gq.conta=4582351 gq.valido=true gq.erro=null
resposta limites_instancia=null posicao.instancia=DESLIGADA posicao.operacoes=null
# v1.36.2: as recusas da corretora no dia (SPEC técnica v1.36 §5.1)
resposta recusas_corretora_hoje.quantidade=0 recusas_corretora_hoje.ultima=null
http GET /usuarios/1450/real?historico=0
resposta _status=400 codigo=CAMPO_INVALIDO

# --- as recusas do aprovar (v1.36: sem visto e sem limites; a ação limites saiu)
http POST /usuarios/1450/real/aprovar {"motivo":"fase 1","versao":0}
resposta _status=400 codigo=CAMPO_INVALIDO "motivo=~por"
http POST /usuarios/1450/real/aprovar {"por":1450,"motivo":"ok","versao":0}
resposta _status=400 codigo=CAMPO_INVALIDO "motivo=~3 a 200"
http POST /usuarios/1450/real/aprovar {"por":1450,"motivo":"fase 1","versao":1}
resposta _status=409 codigo=VERSAO_MUDOU
http POST /usuarios/1450/real/aprovar {"por":1450,"motivo":"fase 1"}
resposta _status=400 codigo=CAMPO_INVALIDO "motivo=~versao"
http POST /usuarios/1450/real/zerar {"por":1450,"motivo":"fase 1","versao":0}
resposta _status=400 codigo=CAMPO_INVALIDO
http POST /usuarios/1450/real/limites {"por":1450,"motivo":"fase 1: 1 e 1","versao":0,"qtd_max_ordem":1,"posicao_max":1}
resposta _status=400 codigo=CAMPO_INVALIDO "motivo=~aprovar, bloquear, desbloquear, revogar"
http POST /usuarios/1450/real/bloquear {"por":1450,"motivo":"antes de aprovar","versao":0}
resposta _status=409 codigo=TRANSICAO_INVALIDA "motivo=~SEM_APROVACAO"

# --- aprovar (só o uid: sem conta, sem limites) e bloquear
http POST /usuarios/1450/real/aprovar {"por":1450,"motivo":"fase 1","versao":0}
resposta _status=200 aceito=true codigo=APROVADO estado=APROVADO versao=1 "motivo=uid 1450 aprovado no REAL"
evento ADMIN_ACAO acao=REAL_APROVAR uid=1450 ambiente=REAL por=admin:1450
http GET /usuarios/1450/real
resposta estado=APROVADO versao=1 acoes.#=2 acoes.0=bloquear acoes.1=revogar aprovado.por=admin:1450 "aprovado.motivo=fase 1" aprovado.conta=null aprovado.qtd_max_ordem=null
http POST /usuarios/1450/real/bloquear {"por":1450,"motivo":"conta em revisao","versao":1}
resposta _status=200 codigo=BLOQUEADO estado=BLOQUEADO versao=2
http POST /usuarios/1450/real/aprovar {"por":1450,"motivo":"de novo","versao":2}
resposta _status=409 codigo=TRANSICAO_INVALIDA estado=BLOQUEADO versao=2

# --- o GQ muda durante o bloqueio: nada é gravado, nenhum alerta (D6: a conta é livre)
gq 1450 prd {"Robo":{"Conector":"PNT","CORSeqId":85,"CCONroConta":"1234567"}}
avanca 31s
http GET /usuarios/1450/real
resposta estado=BLOQUEADO versao=2 gq.conta=1234567 gq.valido=true aprovado.conta=null divergencia=null

# --- desbloquear: sempre de volta a APROVADO
http POST /usuarios/1450/real/desbloquear {"por":1450,"motivo":"revisao feita","versao":2}
resposta _status=200 codigo=DESBLOQUEADO estado=APROVADO versao=3
http POST /usuarios/1450/real/revogar {"por":1450,"motivo":"fim do teste","versao":3}
resposta _status=200 codigo=REVOGADO estado=REVOGADO versao=4

# --- o corpo das telas F1 (visto e limites): aceito e ignorado
http POST /usuarios/1450/real/aprovar {"por":1450,"motivo":"tela F1","versao":4,"visto":{"conector":"PNT","corretora_codigo":85,"conta":"9999999"},"qtd_max_ordem":5,"posicao_max":5}
resposta _status=200 codigo=APROVADO estado=APROVADO versao=5
http GET /usuarios/1450/real
resposta aprovado.conta=null aprovado.qtd_max_ordem=null aprovado.posicao_max=null "aprovado.motivo=tela F1"

# --- o cadastro do GQ que o sistema não atende: a ficha diz a causa; o aprovar é aceito, com o aviso
gq 1450 prd {"Robo":{"Conector":"PNT","CORSeqId":107,"CCONroConta":"4582351"}}
http GET /usuarios/1450/real
resposta estado=APROVADO gq.valido=false gq.erro.codigo=REAL_CADASTRO_INUTILIZAVEL gq.erro.causa=CORRETORA_NAO_ATENDIDA gq.corretora_codigo=107 gq.conta=4582351 "gq.erro.motivo=~corretora 107 nao atendida pelo PnT"
contrato docs/SPEC-TECNICA-v1.36-CONTA-LIVRE.md 5.1
http POST /usuarios/1450/real/revogar {"por":1450,"motivo":"de novo","versao":5}
resposta _status=200 codigo=REVOGADO versao=6
http POST /usuarios/1450/real/aprovar {"por":1450,"motivo":"de novo","versao":6}
resposta _status=200 codigo=APROVADO estado=APROVADO versao=7 "motivo=~cadastro do GQ nao utilizavel: hoje corretora 107"
# com o REAL desligado o verificador não roda
avanca 31s
sem_alerta REAL_CADASTRO_INUTILIZAVEL
http GET /usuarios/real
resposta usuarios.#=1 usuarios.0.uid=1450 usuarios.0.estado=APROVADO usuarios.0.conta=4582351 usuarios.0.corretora_codigo=107 usuarios.0.cadastro_utilizavel=false usuarios.0.qtd_max_ordem=null usuarios.0.versao=7 usuarios.0.origem=TELA usuarios.0.recusas_corretora_hoje=0
contrato docs/SPEC-TECNICA-v1.36-CONTA-LIVRE.md 5.2

# --- o GQ ilegível: a ficha diz, sem os campos
gq 1450 prd {"Robo":
http GET /usuarios/1450/real
resposta gq.valido=false gq.erro.causa=CADASTRO_ILEGIVEL gq.conta=null divergencia=null

# --- o histórico (o mais recente primeiro)
http GET /usuarios/1450/real?historico=3
resposta historico.#=3 historico.0.evento=APROVAR historico.0.estado_antes=REVOGADO historico.0.origem=TELA historico.0.por=admin:1450 historico.0.conta=null historico.1.evento=REVOGAR historico.2.evento=APROVAR
http GET /usuarios/1450/real?historico=200
resposta historico.#=7 historico.6.evento=APROVAR historico.6.estado_antes=SEM_APROVACAO historico.4.evento=DESBLOQUEAR

# --- o CONTA_DIVERGENTE que a v1.35 tenha deixado vale como APROVADO (as ações dele)
usuario 36 prd {"Robo":{"Conector":"PNT","CORSeqId":85,"CCONroConta":"36"}}
aprova 36 estado=CONTA_DIVERGENTE conta=35 corretora=85
http GET /usuarios/36/real
resposta estado=APROVADO acoes.#=2 acoes.0=bloquear acoes.1=revogar historico.0.estado=CONTA_DIVERGENTE historico.0.conta=35
http POST /usuarios/36/real/bloquear {"por":1450,"motivo":"pausa","versao":1}
resposta _status=200 codigo=BLOQUEADO estado=BLOQUEADO versao=2

# --- a rota antiga no REAL e a stop sem a instância REAL
http POST /usuarios/1450/habilitacao?ambiente=REAL {"habilitado":true,"motivo":"x","por":1450}
resposta _status=409 codigo=USE_APROVACAO_REAL
http GET /usuarios/1450/stop
resposta _status=409 codigo=INSTANCIA_DESLIGADA ambiente=REAL
