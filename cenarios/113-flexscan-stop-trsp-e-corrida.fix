cenario 113 Flexscan: a 234335 de 27/10 — stop movida pelo TRSP; a SAIDA TRSP do gestor chega com a stop executando; ZERADA origem STOP_SERVIDOR motivo TRSP stop_origem TRSP, sem RECUSA_; o reenvio da SAIDA: a resposta original, sem alerta
hora 2026-10-27 12:00:00
# SPEC v1.19 §1, §3, §4. Na .53 (234335, 5725): a SAIDA TRSP do Kalman foi aceita 23 ms antes de o
# fill da stop chegar; o cancel (DELETE) voltou "ordem já executada" e saiu um RECUSA_PNT. Agora: o
# fill zera pela stop (origem STOP_SERVIDOR, o motivo é o do pedido do gestor), o ZERADA traz a
# origem da stop (TRSP) e o 35=9 com 39=2 de uma ordem já executada é só registro.
config FLEXSCAN_URL=falso
usuario 8 hml {"Robo":{"CORSeqId":88,"CCONroConta":"S-1117150"}}
habilita 8 conectores=flexscan

executa INICIO
executa COMPRADO_FLX OP=11301
conta_eventos PROTEGIDA operacao_id=11301 stop_origem=INICIAL = 1

# TRSP: o PUT confirmado muda a origem
preco bid=130300 ask=130305 preco=130300
stop 11301 preco=130200 origem=TRSP uid=8
resposta aceito=true situacao=ENVIADO
flx_recebe PUT id=$FP stopPrice=130200 price=130100
evento PROTECAO_AJUSTADA operacao_id=11301 preco_stop=130200 stop_origem=TRSP
flx_ordem $FP status=5 stop=130200
http GET /ordens/11301
resposta stop_origem=TRSP conector=FLEXSCAN

# a B3 executa a stop; a SAIDA TRSP do gestor chega antes de o serviço saber
preco bid=130190 ask=130195 preco=130190
flx_executa $FP preco=130195
saida 11301 V TRSP uid=8
resposta aceito=true
flx_recebe DELETE id=$FP
evento SAIDA_EXECUTADA operacao_id=11301 qtd=1 preco=130195 origem=STOP_SERVIDOR stop_origem=TRSP
evento ZERADA operacao_id=11301 origem=STOP_SERVIDOR motivo=TRSP pnl_pts=185 stop_origem=TRSP
avanca 6s
sem_alerta RECUSA_FLEXSCAN
sem_alerta RECUSA_PNT
sem_alerta CANCEL_STOP_REJEITADO
flx_nada

# o reenvio do mesmo corpo: a resposta original (idempotente), sem alerta. A SAIDA que chega só
# depois do ZERADA pela stop (234334: SEM_POSICAO sem alerta) está no roteiro 112.
saida 11301 V TRSP uid=8
resposta aceito=true repetido=true estado_atual.estado=ZERADA estado_atual.stop_origem=TRSP
sem_alerta SEM_POSICAO
saude posicao=0 divergente=false parada=null
flx_nada
nada
