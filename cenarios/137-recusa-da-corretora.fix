entrada 13704 C ambiente=REAL
resposta aceito=true
recebe 35=D 11=KM-E-13704-1 1=12345 38=1 54=1 847=1031
envia @ER 11=KM-E-13704-1 37=dsa.13704 150=0 39=0 54=1 38=1 44=130020 847=1031 14=0 151=1 6=0
envia @ER 11=KM-E-13704-1 37=dsa.13704 150=F 39=2 54=1 38=1 44=130020 847=1031 32=1 31=130010 14=1 151=0 6=130010
evento ENTRADA_EXECUTADA operacao_id=13704 qtd=1 preco=130010
recebe 35=D 11=KM-P-13704-1 1=12345 38=1 54=2 847=1014 20828=129510 20829=129410
evento ENTRADA_ENCERRADA operacao_id=13704 qtd_final=1 texto=null
