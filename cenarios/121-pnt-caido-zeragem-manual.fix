cenario 121 PnT caído com posição aberta (v1.28 §3): na hora, saída, ajuste do stop e ações do admin recusados (CONECTOR_FORA) e o canal fora no /saude e no /destino; depois de CONECTOR_FORA_TOLERANCIA_S a operação fica SUSPENSA com o alerta crítico para o usuário agir à mão; na volta, nada sai por ela e a conciliação só sugere (sem DESCONHECIDA nem DIVERGENTE, sem recriar a stop); a suspensão sobrevive ao restart; o admin confirma a posição na corretora — outra: divergência; 0 com a stop cancelada fora: ENCERRADA_FORA sem ordem; 0 com a stop viva: só o cancel dela; a mesma: retoma
hora 2026-10-30 10:30:00
config LIMITE_INTERVALO_ENTRADAS_S=0
config LIMITE_ENTRADAS_MIN=10

executa INICIO
executa COMPRADO OP=12101

# --- o PnT cai e não volta (recusa o logon)
pnt_recusa_logon "sessao indisponivel"
derruba_sessao
alerta SESSAO_CAIU
avanca 2s
saude sessao_logada=false posicao=1 canais.PNT.estado=FORA canais.PNT.motivo="a sessão FIX caiu" canais.FLEXSCAN.estado=DESLIGADO

# na hora: a saída, o ajuste do stop e o encerrar do admin são recusados; nada fica guardado, nem vai
# por outro conector
saida 12101 V SINAL_OPOSTO
resposta aceito=false codigo=CONECTOR_FORA
stop 12101 preco=129800
resposta aceito=false codigo=CONECTOR_FORA
http POST /operacoes/12101/encerrar {"motivo":"teste","por":12}
resposta aceito=false codigo=CONECTOR_FORA
# o /destino mostra o canal: o Kalman para de pedir
http GET /usuarios/7/destino
resposta ambientes.SIMULADOR.canal=FORA ambientes.SIMULADOR.pode_enviar=false ambientes.SIMULADOR.codigo=SEM_SESSAO
sem_alerta CONECTOR_FORA_COM_POSICAO

# 30 s fora com a posição: SUSPENSA, o alerta crítico com tudo para agir à mão
avanca 30s
evento ALERTA codigo=CONECTOR_FORA_COM_POSICAO texto="~Posicao: comprado 1 WINZ26, preco medio 130010, na BTG, conta 12345. Protegendo: a stop KM-P-12101-1 (gatilho 129510, limite 129410, 1 contrato(s)) segue valendo na corretora. O servico nao manda nada por esse canal enquanto ele estiver fora, nem sai por outro conector. Para sair ja: home broker, Profit ou mesa"
evento SUSPENSA operacao_id=12101 conta=12345 corretora=BTG posicao=1 lado=C qtd=1 stop.preco_stop=129510
saude operacoes_suspensas.0.operacao_id=12101 operacoes_suspensas.0.conta=12345 operacoes_suspensas.0.sugestao=null
http GET /ordens/12101
resposta suspensa.motivo="~PnT fora do ar" estado=PROTEGIDA posicao=1

# --- o usuário zera pelo home broker e cancela a stop lá; o PnT volta. O mass status não traz a
# 1014 (a venda do home broker não é KM): nada de DESCONHECIDA, de DIVERGENTE nem de stop nova
pnt_aceita_logon
aguarda_logon
recebe 35=AF 585=9 1=12345 584=>MS
avanca 3s
alerta CONCILIACAO
evento ALERTA codigo=OPERACAO_SUSPENSA texto="~stop cancelada fora sem fill: provavel zeragem manual"
sem_alerta DESCONHECIDA
sem_alerta DIVERGENTE
saude sessao_logada=true divergente=false parada=null posicao=1 canais.PNT.estado=NO_AR operacoes_suspensas.0.sugestao="~provável zeragem manual"
evento SUSPENSA_CONFERIR operacao_id=12101 sugestao="~zeragem manual"
http GET /usuarios/7/destino
resposta ambientes.SIMULADOR.canal=NO_AR ambientes.SIMULADOR.pode_enviar=true
# nada sai por ela: o pedido do gestor é recusado; nem a stop é recriada com o tempo
saida 12101 V SINAL_OPOSTO
resposta aceito=false codigo=OPERACAO_SUSPENSA
avanca 60s
nada
sem_alerta SEM_PROTECAO

# --- restart: continua suspensa (gravada); a conciliação sugere de novo
reinicia_servico
aguarda_logon
recebe 35=AF 585=9 1=12345 584=>MS2
avanca 3s
alerta OPERACAO_SUSPENSA
http GET /ordens/12101
resposta suspensa.sugestao="~zeragem manual" estado=PROTEGIDA posicao=1
nada

# --- a confirmação: outra posição → divergência clara, segue suspensa
http POST /operacoes/12101/confirmar-posicao {"posicao":-1,"motivo":"conferi no HB","por":12}
resposta aceito=false codigo=POSICAO_DIVERGENTE posicao_sistema=1 posicao_corretora=-1
evento ALERTA codigo=DIVERGENTE texto="~posicao 1 no sistema e -1 na corretora"
# posicao obrigatória; só vale na suspensa
http POST /operacoes/12101/confirmar-posicao {"motivo":"x","por":12}
resposta aceito=false codigo=CAMPO_INVALIDO
http POST /operacoes/12101/encerrar {"motivo":"x","por":12,"posicao":0}
resposta aceito=false codigo=CAMPO_INVALIDO
# 0: ENCERRADA_FORA, sem ordem (a stop já não existe na corretora)
http POST /operacoes/12101/confirmar-posicao {"posicao":0,"motivo":"zerada no home broker","por":12}
resposta aceito=true codigo=ENCERRADA_FORA posicao_sistema=1 posicao_corretora=0
evento ADMIN_ACAO acao=CONFIRMAR_POSICAO por=12
evento ENCERRADA_FORA operacao_id=12101 posicao_sistema=1 conta=12345 conector=PNT
nada
saude posicao=0 operacoes_suspensas.#=0
http GET /ordens/12101
resposta estado=ENCERRADA_FORA posicao=0 origem_saida=FORA suspensa=null
http POST /operacoes/12101/confirmar-posicao {"posicao":0,"motivo":"de novo","por":12}
resposta aceito=false codigo=OPERACAO_ENCERRADA

# --- outra operação: zerada no home broker sem cancelar a stop (viva na corretora): a confirmação
# de posição 0 manda só o cancel da stop
executa COMPRADO OP=12102
pnt_recusa_logon "sessao indisponivel"
derruba_sessao
avanca 31s
alerta CONECTOR_FORA_COM_POSICAO
pnt_aceita_logon
aguarda_logon
recebe 35=AF 585=9 1=12345 584=>MS3
envia @ER 11=KM-P-12102-1 37=dsa.12102.P 150=I 39=0 584=$MS3 54=2 38=1 44=129410 847=1014 14=0 151=1 6=0 20828=129510.0000000001 20829=129410.0000000001
avanca 3s
evento ALERTA codigo=OPERACAO_SUSPENSA texto="~stop viva na corretora, sem fill"
nada
http POST /operacoes/12102/confirmar-posicao {"posicao":0,"motivo":"zerada no HB, a stop ficou","por":12}
resposta aceito=true codigo=CANCELANDO_STOP
recebe 35=F 11=KM-P-12102-2 41=KM-P-12102-1 1=12345
envia @ER 11=KM-P-12102-2 41=KM-P-12102-1 37=dsa.12102.P 150=4 39=4 54=2 38=1 44=129410 847=1014 14=0 151=0 6=0
evento ENCERRADA_FORA operacao_id=12102
nada
saude posicao=0

# --- e uma em que nada mudou: a mesma posição → retoma; a saída do gestor volta a andar
executa COMPRADO OP=12103
pnt_recusa_logon "sessao indisponivel"
derruba_sessao
avanca 31s
alerta CONECTOR_FORA_COM_POSICAO
pnt_aceita_logon
aguarda_logon
recebe 35=AF 585=9 1=12345 584=>MS4
envia @ER 11=KM-P-12103-1 37=dsa.12103.P 150=I 39=0 584=$MS4 54=2 38=1 44=129410 847=1014 14=0 151=1 6=0 20828=129510.0000000001 20829=129410.0000000001
avanca 3s
alerta OPERACAO_SUSPENSA
http POST /operacoes/12103/confirmar-posicao {"posicao":1,"motivo":"conferi: segue comprado","por":12}
resposta aceito=true codigo=RETOMADA
evento RETOMADA operacao_id=12103 posicao=1
nada
preco bid=130100 ask=130105 preco=130100
saida 12103 V SINAL_OPOSTO
resposta aceito=true
recebe 35=F 11=KM-P-12103-2 41=KM-P-12103-1 1=12345
envia @ER 11=KM-P-12103-2 41=KM-P-12103-1 37=dsa.12103.P 150=4 39=4 54=2 38=1 44=129410 847=1014 14=0 151=0 6=0
recebe 35=D 11=KM-S-12103-1 1=12345 55=WINZ26 847=1031
envia @ER 11=KM-S-12103-1 37=dsa.12103.S 150=F 39=2 54=2 38=1 44=130050 847=1031 32=1 31=130100 14=1 151=0 6=130100
evento ZERADA operacao_id=12103 origem=GESTOR
saude posicao=0 operacoes_suspensas.#=0
nada

# --- a stop cancelada no home broker chega pelo reenvio do PnT (o 39=4 de fora, na queda): a
# operação suspensa não recria a stop (nada de PROTECAO_RECRIADA em série); a sugestão é a mesma
preco bid=130000 ask=130005 preco=130000
executa COMPRADO OP=12104
pnt_recusa_logon "sessao indisponivel"
derruba_sessao
avanca 31s
evento ALERTA codigo=CONECTOR_FORA_COM_POSICAO operacao_id=12104
envia_offline @ER 11=KM-P-12104-1 37=dsa.12104.P 150=4 39=4 54=2 38=1 44=129410 847=1014 14=0 151=0 6=0
pnt_aceita_logon
aguarda_logon
recebe 35=AF 585=9 1=12345 584=>MS5
avanca 3s
evento ALERTA codigo=OPERACAO_SUSPENSA texto="~stop cancelada fora sem fill: provavel zeragem manual"
# o 39=4 chegou pelo reenvio (a stop está CANCELADA, não só ausente no mass status)
http GET /ordens/12104
resposta ordens.1.papel=P ordens.1.estado=CANCELADA suspensa.sugestao="~zeragem manual"
avanca 10s
sem_alerta PROTECAO_RECRIADA
sem_alerta SEM_PROTECAO
nada
http POST /operacoes/12104/confirmar-posicao {"posicao":0,"motivo":"zerada no HB","por":12}
resposta aceito=true codigo=ENCERRADA_FORA
evento ENCERRADA_FORA operacao_id=12104
saude posicao=0 operacoes_suspensas.#=0
nada
