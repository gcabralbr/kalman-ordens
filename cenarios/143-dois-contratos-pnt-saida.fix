cenario 143 2 contratos no PnT: a saída por replace com 38=2 (disparo e fill de 2); a 1014 de 2 que executa 1 (o gestor vira ja_em_saida; o furo cancela o resto e manda a 1031 de 1); a saída por replace com fill parcial de 1 e o resto preso no limite
hora 2026-11-25 10:20:00
# Pedido do George (25/11, item 4.1): antes de subir a quantidade no REAL, provar que a saída trata
# qtd > 1. COMPRADO de 2 a 130010; a 1014 de 2 com gatilho 129510 e limite 129410.
config SAIDA_POR_REPLACE=1
config LIMITE_POSICAO_MAX=2
config LIMITE_QTD_ORDEM=2
config LIMITE_INTERVALO_ENTRADAS_S=0
config LIMITE_ENTRADAS_MIN=10
config LIMITE_MENSAGENS_MIN=1000
config LIMITE_ENTRADAS_DIA=100
config LIMITE_RECUSAS_PARADA=50
config LIMITE_PERDA_DIA_PTS=100000

executa INICIO

# --- a) a saída por replace com 2: o replace leva 38=2 (degrau 1: gatilho bid + 100, limite bid − 50),
# o disparo ("Delaying final state") e o fill de 2 zeram
entrada 14301 C qtd=2
resposta aceito=true
recebe 35=D 11=KM-E-14301-1 38=2 40=2 44=130020 54=1 847=1031
