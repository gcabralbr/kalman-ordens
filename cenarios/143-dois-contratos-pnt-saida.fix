evento ENTRADA_EXECUTADA operacao_id=14301 qtd=2 preco=130010 qtd_total=2 preco_medio=130010
recebe 35=D 11=KM-P-14301-1 38=2 40=2 44=129410 54=2 847=1014 20828=129510 20829=129410
envia @ER 11=KM-P-14301-1 37=dsa.14301.P 150=0 39=0 54=2 38=2 44=129410 847=1014 14=0 151=2 6=0
evento PROTEGIDA operacao_id=14301 preco_stop=129510 preco_limite=129410 qtd=2
saude posicao=2
saida 14301 V SINAL_OPOSTO qtd=2
resposta aceito=true
recebe 35=G 11=KM-P-14301-2 41=KM-P-14301-1 37=dsa.14301.P 38=2 44=129950 20828=130100 20829=129950
evento SAIDA_POR_REPLACE operacao_id=14301 degrau=1 preco_stop=130100 preco_limite=129950
envia @ER 11=KM-P-14301-2 41=KM-P-14301-1 37=dsa.14301.P 150=5 39=5 54=2 38=2 44=129950 847=1014 14=0 151=2 6=0 20828=130100 20829=129950
avanca 500ms
envia @ER 11=KM-P-14301-2 37=dsa.14301.P 150=I 39=B 54=2 38=2 44=129950 847=1014 14=0 151=2 6=0 20807=0 58="Delaying final state 'Finished' for 3.00 s, timer started."
envia @ER 11=KM-P-14301-2 37=dsa.14301.P 150=F 39=2 54=2 38=2 44=129950 847=1014 32=2 31=130000 14=2 151=0 6=130000
evento SAIDA_EXECUTADA operacao_id=14301 qtd=2 preco=130000 origem=GESTOR
# (130000 − 130010) × 2
evento ZERADA operacao_id=14301 motivo=SINAL_OPOSTO origem=GESTOR pnl_pts=-20
saude posicao=0
nada
sem_alerta STOP_FURADO

# --- b) a 1014 de 2 executa 1 (39=1): a saída já é do stop (STOP_SERVIDOR) e o pedido do gestor é aceito
# como ja_em_saida, sem ordem nova. O resto depende do limite da 1014 (129410): o mercado passa dele e,
# em ESPERA_STOP_S, o stop furado cancela o resto e, com o 150=4, manda a 1031 de 1 (nunca 2)
