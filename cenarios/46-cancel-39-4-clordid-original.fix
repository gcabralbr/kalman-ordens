recebe 35=F 11=KM-P-4602-2 41=KM-P-4602-1 37=dsa.4602.P 38=1 54=2
envia @ER 11=KM-P-4602-2 41=KM-P-4602-1 37=dsa.4602.P 150=6 39=6 54=2 38=1 44=129410 847=1014 14=0 151=1 6=0
avanca 5s
nada 35=D
sem_alerta CANCEL_SEM_RESPOSTA
envia @ER 11=KM-P-4602-1 41=KM-P-4602-1 37=dsa.4602.P 150=4 39=4 54=2 38=1 44=129410 847=1014 14=0 151=0 6=0
recebe 35=D 11=KM-S-4602-1 38=1 44=130050 54=2 847=1031
