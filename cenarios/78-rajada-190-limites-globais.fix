cenario 78 Rajada de 190 usuários no mesmo sinal passa nos limites globais da v1.10 (padrões)
hora 2026-10-16 10:00:00
# SPEC v1.10 L. Os limites globais somam todos os usuários; os padrões da v1.10 são para rajadas
# de 190 (posição 200, 400 entradas/min, intervalo global 0, 3.000 mensagens/min, 3.000/dia, parada
# em 50 recusas). Aqui os padrões são repostos (o _comum.fix fixa os de um usuário só) e os limites
# por uid ficam ligados nos padrões (3/min, 30 s): uma entrada por uid não esbarra em nada.
# Gerado: 190 uids (2000–2189), todos na conta 12345.
config LIMITE_POSICAO_MAX=200
config LIMITE_INTERVALO_ENTRADAS_S=0
config LIMITE_ENTRADAS_MIN=400
config LIMITE_MENSAGENS_MIN=3000
config LIMITE_ENTRADAS_DIA=3000
config LIMITE_RECUSAS_PARADA=50
config LIMITE_ENTRADAS_MIN_UID=3
config LIMITE_INTERVALO_UID_S=30
config FIX_TAXA_MSG_S=1000
config FIX_RAJADA_MSG=1000
