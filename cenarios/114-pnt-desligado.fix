cenario 114 PNT_DESLIGADO: a sessão FIX é ignorada (nada vai ao PnT), entrada de uid PNT recusada com CONECTOR_DESLIGADO, a Flexscan inteira normal
hora 2026-10-28 10:00:00
# SPEC v1.19.1 (28/10: HML do PnT desligada). Em produção, com PNT_DESLIGADO=1 o serviço nem cria a
# sessão FIX; aqui o PnT falso continua de pé e o motor ignora a sessão: nenhuma mensagem de
# aplicação sai para ele, nenhum alerta de sessão, sessao_logada false.
config PNT_DESLIGADO=1
config FLEXSCAN_URL=falso
usuario 8 hml {"Robo":{"CORSeqId":88,"CCONroConta":"S-1117150"}}
habilita 8 conectores=flexscan

preco ticker=WINZ26 bid=130000 ask=130005 preco=130000 status84=0 idade=100ms
# a sessão do falso loga; o motor não a usa (sem conciliação pelo PnT, sem SESSAO_*)
aguarda_logon
avanca 3s
alerta CONCILIACAO
saude sessao_logada=false pnt_desligado=true conciliando=false posicao=0 parada=null divergente=false flexscan.logado=true
# v1.21: a fonte única aparece também no bloco da Flexscan (era nulo na .53 em 27/10)
saude flexscan.simbolo=WINZ26 flexscan.fonte.compartilhada=true flexscan.idade_preco_ms=*

# uid 7 (habilitado só no PnT): recusa clara, nada enviado
entrada 11401 C
resposta aceito=false codigo=CONECTOR_DESLIGADO
nada

# a Flexscan: entrada, proteção, ajuste TRSP, saída
executa COMPRADO_FLX OP=11402
stop 11402 preco=129800 origem=TRSP uid=8
resposta aceito=true situacao=ENVIADO
flx_recebe PUT id=$FP stopPrice=129800 price=129700
evento PROTECAO_AJUSTADA operacao_id=11402 preco_stop=129800 stop_origem=TRSP
preco bid=130100 ask=130105 preco=130100
saida 11402 V SINAL_OPOSTO uid=8
resposta aceito=true
flx_recebe DELETE id=$FP
flx_recebe POST name=KM-S-11402-1 side=2 qtty=1 ordType=2 price=130050 id=>S1
flx_executa $S1 preco=130100
flx_webhook $S1
evento SAIDA_EXECUTADA operacao_id=11402 qtd=1 preco=130100 origem=GESTOR
evento ZERADA operacao_id=11402 pnl_pts=90 origem=GESTOR
saude posicao=0 sessao_logada=false pnt_desligado=true

avanca 1m
sem_alerta SESSAO_CAIU
sem_alerta SESSAO_VOLTOU
sem_alerta FONTE_DEGRADADA
sem_alerta DIVERGENTE
flx_nada
nada
