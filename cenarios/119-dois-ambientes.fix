cenario 119 Os dois ambientes ao mesmo tempo (v1.26, SPEC-AMBIENTES-v1 §10): uma instância por ambiente, cada uma com a sua Flexscan (duas falsas) — o mesmo uid com posição no SIMULADOR e no REAL, cada ordem na conta e na Flexscan do seu ambiente; a entrada repetida com outro ambiente (AMBIENTE_DIVERGENTE de ponta a ponta); o teto do REAL (uid, conta, quantidade); o retrato do REAL no caminho do webhook do SIMULADOR não vira fill; a parada só do REAL e a das duas; o restart recarrega cada operação na sua instância; o tráfego por ambiente
hora 2026-10-30 10:00:00
config ORDENS_AMBIENTE=
config AMBIENTES_PERMITIDOS=SIM,REAL
config FLEXSCAN_URL=falso
config REAL_FLEXSCAN_URL=falso
config REAL_UIDS=8,10
config REAL_CONTAS=715124
config REAL_LIMITE_QTD_ORDEM=1
config REAL_LIMITE_PERDA_DIA_PTS=300
config REAL_LIMITE_ENTRADAS_DIA=10
config LIMITE_INTERVALO_ENTRADAS_S=0
config LIMITE_ENTRADAS_MIN=10
config LIMITE_RECUSAS_PARADA=50
# o 5725 (uid 8): o simulador externo no usutxtconfig, a conta real no usutxtconfigprd
usuario 8 hml {"Robo":{"Conector":"FLEXSCAN","CORSeqId":85,"CCONroConta":"S-1117150"}}
usuario 8 prd {"Robo":{"Conector":"FLEXSCAN","CORSeqId":88,"CCONroConta":"715124"}}
habilita 8 conectores=flexscan
habilita 8 ambiente=REAL conectores=flexscan
# uid 10: em REAL_UIDS, com uma conta fora de REAL_CONTAS; uid 11: fora de REAL_UIDS
usuario 10 prd {"Robo":{"Conector":"FLEXSCAN","CORSeqId":88,"CCONroConta":"715125"}}
habilita 10 ambiente=REAL conectores=flexscan
usuario 11 prd {"Robo":{"Conector":"FLEXSCAN","CORSeqId":88,"CCONroConta":"715124"}}
habilita 11 ambiente=REAL conectores=flexscan

# as duas instâncias no ar, cada uma logada na sua Flexscan; o SIMULADOR sem a sessão FIX
preco ticker=WINZ26 bid=130000 ask=130005 preco=130000 status84=0 idade=100ms
aguarda_logon
avanca 3s
alerta CONCILIACAO
saude sessao_logada=false posicao=0 parada=null ambientes_permitidos.0=SIMULADOR ambientes_permitidos.1=REAL
saude ambientes.SIMULADOR.flexscan.logado=true ambientes.REAL.flexscan.logado=true ambientes.REAL.posicao=0 ambientes.REAL.pnt_desligado=true

# --- o mesmo uid nos dois ambientes: a entrada do SIMULADOR vai à Flexscan do simulador
entrada 11901 C uid=8 ambiente=SIMULADOR
resposta aceito=true ambiente=SIMULADOR
flx_recebe POST name=KM-E-11901-1 account=S-1117150 id=>E1
flx_executa $E1 preco=130010
flx_webhook $E1
evento ENTRADA_EXECUTADA operacao_id=11901 ambiente=SIMULADOR
flx_recebe POST name=KM-P-11901-1 ordType=4 id=>P1
evento PROTEGIDA operacao_id=11901 ambiente=SIMULADOR

# a do REAL, à Flexscan de produção, com a conta real; nada na do simulador
entrada 11902 C uid=8 ambiente=REAL
resposta aceito=true ambiente=REAL
flx_nada
flx_ambiente REAL
flx_recebe POST name=KM-E-11902-1 account=715124 id=>E2
flx_executa $E2 preco=130010
flx_webhook $E2
evento ENTRADA_EXECUTADA operacao_id=11902 ambiente=REAL
flx_recebe POST name=KM-P-11902-1 ordType=4 id=>P2
evento PROTEGIDA operacao_id=11902 ambiente=REAL
saude posicao=1 ambientes.SIMULADOR.posicao=1 ambientes.REAL.posicao=1
http GET /ordens/11902
resposta ambiente=REAL conta=715124 conector=FLEXSCAN
http GET /ordens/11901
resposta ambiente=SIMULADOR conta=S-1117150

# --- a entrada repetida com o outro ambiente: a instância dona recusa
entrada 11902 C uid=8 ambiente=SIMULADOR
resposta aceito=false codigo=AMBIENTE_DIVERGENTE
entrada 11901 C uid=8 ambiente=REAL
resposta aceito=false codigo=AMBIENTE_DIVERGENTE
flx_nada

# --- o teto do REAL: uid fora de REAL_UIDS, conta fora de REAL_CONTAS, 2 contratos
entrada 11903 C uid=11 ambiente=REAL
resposta aceito=false codigo=REAL_UID_NAO_PERMITIDO
alerta REAL_UID_NAO_PERMITIDO
entrada 11904 C uid=10 ambiente=REAL
resposta aceito=false codigo=REAL_CONTA_NAO_PERMITIDA
alerta REAL_CONTA_NAO_PERMITIDA
entrada 11905 C uid=8 ambiente=REAL qtd=2
resposta aceito=false codigo=QTD_MAXIMA
flx_nada

# --- o retrato da ordem do REAL entregue no caminho do webhook do SIMULADOR: a ponte do simulador
# não a conhece, a consulta na Flexscan do simulador não a acha; nenhum fill, nenhuma posição nova
flx_executa $P2 preco=129500
flx_webhook_em SIMULADOR $P2
sem_evento SAIDA_EXECUTADA operacao_id=11902
saude ambientes.REAL.posicao=1 ambientes.SIMULADOR.posicao=1
# o mesmo retrato no caminho certo: o stop do REAL executou
sem_alerta FLEXSCAN_WEBHOOK_INCOERENTE
flx_webhook $P2
evento SAIDA_EXECUTADA operacao_id=11902 origem=STOP_SERVIDOR
evento ZERADA operacao_id=11902 ambiente=REAL
avanca 1s
saude ambientes.REAL.posicao=0 ambientes.SIMULADOR.posicao=1
# a perda do dia do REAL (-510 pts, acima do REAL_LIMITE_PERDA_DIA_PTS=300) para só o REAL; o
# SIMULADOR (-10 pts, limite 1500) segue
saude ambientes.REAL.parada.modo=BLOQUEAR ambientes.REAL.parada.origem=auto ambientes.REAL.limites.resultado_dia_pts=-510
saude ambientes.SIMULADOR.parada=null parada=null ambientes.SIMULADOR.limites.resultado_dia_pts=-10
entrada 11906 C uid=8 ambiente=REAL
resposta aceito=false codigo=PARADA

# --- a parada e a retomada só do REAL pelo admin: o SIMULADOR segue
http POST /parada {"modo":"BLOQUEAR","origem":"ADMIN","motivo":"teste","por":12,"ambiente":"REAL"}
resposta aceito=true ambiente=REAL ambientes.REAL.codigo=PARADA_ATIVA
saude ambientes.REAL.parada.origem=ADMIN ambientes.SIMULADOR.parada=null parada=null
http POST /retomar {"origem":"ADMIN","motivo":"fim","por":12,"ambiente":"REAL"}
resposta aceito=true codigo=RETOMADO
# sem ambiente: as duas
http POST /parada {"modo":"BLOQUEAR","origem":"admin","motivo":"teste","por":12}
contrato docs/SPEC-AMBIENTES-v1.md 10.3
resposta aceito=true ambientes.SIMULADOR.codigo=PARADA_ATIVA ambientes.REAL.codigo=PARADA_ATIVA
saude parada.modo=BLOQUEAR ambientes.REAL.parada.modo=BLOQUEAR
http POST /parada {"modo":"BLOQUEAR","origem":"admin","motivo":"x","ambiente":"XPTO"}
resposta aceito=false codigo=AMBIENTE_NAO_PERMITIDO
http POST /retomar {"origem":"admin","motivo":"fim","por":12}
resposta aceito=true ambientes.SIMULADOR.codigo=RETOMADO ambientes.REAL.codigo=RETOMADO
saude parada=null ambientes.REAL.parada=null

# --- restart: cada operação volta na sua instância (a do SIMULADOR protegida, a do REAL zerada); a
# perda do dia do REAL, recontada na partida, para de novo só o REAL
reinicia_servico
aguarda_logon
avanca 3s
saude ambientes.SIMULADOR.posicao=1 ambientes.REAL.posicao=0 parada=null ambientes.REAL.parada.origem=auto ambientes.REAL.limites.resultado_dia_pts=-510
http GET /ordens/11902
resposta ambiente=REAL estado=ZERADA
# a saída do SIMULADOR, com o ambiente gravado
saida 11901 V SINAL_OPOSTO uid=8 ambiente=SIMULADOR
resposta aceito=true
flx_ambiente SIMULADOR
flx_recebe DELETE id=$P1
flx_recebe POST name=KM-S-11901-1 account=S-1117150 id=>S1
flx_executa $S1 preco=130100
flx_webhook $S1
evento ZERADA operacao_id=11901 ambiente=SIMULADOR
saude posicao=0 ambientes.REAL.posicao=0

# --- o tráfego por ambiente: cada ponte só tem as trocas dela
flx_trafego tipo=POST clordid=KM-E-11901-1 = 1
flx_trafego tipo=POST clordid=KM-E-11902-1 = 0
flx_ambiente REAL
flx_trafego tipo=POST clordid=KM-E-11902-1 = 1
flx_trafego tipo=POST clordid=KM-E-11901-1 = 0
http GET /flexscan/trafego?ambiente=REAL&limite=1
resposta ambiente=REAL
http GET /flexscan/trafego?limite=1
resposta ambiente=SIMULADOR
http GET /flexscan/trafego?ambiente=X
resposta _status=400
http GET /operacoes?dia=2026-10-30&ambiente=REAL
resposta _lista.0.ambiente=REAL
