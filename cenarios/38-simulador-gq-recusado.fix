cenario 38 Usuário no simulador do GQ (9999 / conta QUANT) → paper: recusa DESTINO_PAPER, sem alerta (o Kalman não devia ter mandado)
hora 2026-10-13 10:05:00
# SPEC-AMBIENTES-v1 §0.1 (29/10, substitui a v1.2 U2): no SIMULADOR, 9999 com a conta QUANT é o
# simulador interno do GQ, o paper: nenhuma ordem vai ao serviço e não é erro de configuração.
# Conta não numérica pelo PnT (o simulador usa "QUANT") → CONTA_INVALIDA + alerta, mesmo com destino 85.

executa INICIO

usuario 7 hml {"AmbienteDef":"Simulador","Robo":{"CORSeqId":9999,"CCONroConta":"QUANT"}}
entrada 3801 C
resposta aceito=false codigo=DESTINO_PAPER
nada

usuario 7 hml {"Robo":{"CORSeqId":85,"CCONroConta":"QUANT"}}
