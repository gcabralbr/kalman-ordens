evento ALERTA codigo=REAL_CADASTRO_INUTILIZAVEL "texto=~uid 9: cadastro do GQ nao utilizavel: corretora 85 sem credencial Flexscan nesta maquina (CORRETORA_NAO_ATENDIDA). Entradas REAL recusadas ate o cadastro ser corrigido. (visto na partida)"
evento ALERTA codigo=REAL_CADASTRO_INUTILIZAVEL "texto=~uid 10: cadastro do GQ nao utilizavel: corretora 77 nao atendida"
http GET /usuarios/9/destino?ambiente=REAL
resposta ambientes.REAL.codigo=REAL_CADASTRO_INUTILIZAVEL ambientes.REAL.causa=CORRETORA_NAO_ATENDIDA "ambientes.REAL.motivo=~corretora 85 sem credencial Flexscan" ambientes.REAL.pode_enviar=false
