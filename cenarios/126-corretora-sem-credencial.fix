cenario 126 O REAL por corretora sem o guarda-chuva da corretora do usuário (v1.30): só a CMC configurada; o usuário da BTG recebe, desde a v1.36 (SPEC-TECNICA-v1.36-CONTA-LIVRE §3), REAL_CADASTRO_INUTILIZAVEL com causa CORRETORA_NAO_ATENDIDA no /destino e na entrada, e um alerta só (o da corretora não declarada também); o da CMC segue normal
hora 2026-10-30 10:00:00
config ORDENS_AMBIENTE=
config AMBIENTES_PERMITIDOS=REAL
config REAL_FLEXSCAN_CORRETORAS=88:CMC
config REAL_FLEXSCAN_CMC_URL=falso
config REAL_FLEXSCAN_CMC_CONTAS=715124
usuario 8 prd {"Robo":{"Conector":"FLEXSCAN","CORSeqId":88,"CCONroConta":"715124"}}
usuario 9 prd {"Robo":{"Conector":"FLEXSCAN","CORSeqId":85,"CCONroConta":"9001"}}
