cenario 60 Ajuste da proteção recusado pelo PnT: evento com o motivo, stop anterior mantido, sem nova tentativa nem zeragem
hora 2026-10-15 10:40:00
# SPEC v1.4 K1. Replace de ajuste da 1014 recusado (35=9, ou 35=j com o 379 = ClOrdID do replace):
# evento PROTECAO_AJUSTE_RECUSADO com o motivo; o stop que está no PnT fica (passa a ser o pedido da
# operação: nada tenta de novo sozinho); o RECUSA_PNT de sempre. Não é a 1014 recusada: nada de
# PROTECAO_REJEITADA nem da zeragem da 2ª rejeição (Parte 3.4) — a posição continua protegida.

executa INICIO
executa COMPRADO OP=6001

stop 6001 preco=129800
resposta aceito=true situacao=ENVIADO
recebe 35=G 11=KM-P-6001-2 41=KM-P-6001-1 37=dsa.6001.P 20828=129800 20829=129700
envia 35=9 11=KM-P-6001-2 41=KM-P-6001-1 37=dsa.6001.P 39=0 434=2 102=99 58="[DSA-xx] Invalid stop price"
evento PROTECAO_AJUSTE_RECUSADO operacao_id=6001 modulo=KALMAN preco_stop_pedido=129800 preco_stop=129510 preco_limite=129410 qtd=1 motivo="[99] [DSA-xx] Invalid stop price"
alerta RECUSA_PNT
sem_evento PROTECAO_AJUSTADA
http GET /ordens/6001
resposta preco_stop_ajustado=129510 estado=PROTEGIDA
avanca 5s
nada

# a segunda recusa seguida também não zera (a 1014 continua viva no PnT)
stop 6001 preco=129850
resposta aceito=true situacao=ENVIADO preco_stop_pnt=129510
recebe 35=G 11=KM-P-6001-3 41=KM-P-6001-1 37=dsa.6001.P 20828=129850 20829=129750
envia 35=9 11=KM-P-6001-3 41=KM-P-6001-1 37=dsa.6001.P 39=0 434=2 102=99 58="[DSA-xx] Invalid stop price"
evento PROTECAO_AJUSTE_RECUSADO operacao_id=6001 preco_stop_pedido=129850 preco_stop=129510
alerta RECUSA_PNT
sem_alerta PROTECAO_REJEITADA
avanca 5s
saude posicao=1 divergente=false parada=null
nada

# recusa por 35=j (Business Message Reject, 379 = o ClOrdID do replace)
stop 6001 preco=129750
resposta aceito=true situacao=ENVIADO
recebe 35=G 11=KM-P-6001-4 41=KM-P-6001-1 37=dsa.6001.P 20828=129750 20829=129650
envia 35=j 372=G 379=KM-P-6001-4 380=0 58="Rejected by risk"
evento PROTECAO_AJUSTE_RECUSADO operacao_id=6001 preco_stop_pedido=129750 preco_stop=129510
alerta RECUSA_PNT
sem_alerta PROTECAO_REJEITADA
nada

# um ajuste aceito depois das recusas: segue normal, a partir do ClOrdID vigente
stop 6001 preco=129700
resposta aceito=true situacao=ENVIADO
recebe 35=G 11=KM-P-6001-5 41=KM-P-6001-1 37=dsa.6001.P 44=129600 20828=129700 20829=129600
envia @ER 11=KM-P-6001-5 41=KM-P-6001-1 37=dsa.6001.P 150=5 39=5 54=2 38=1 44=129600 847=1014 14=0 151=1 6=0
evento PROTECAO_AJUSTADA operacao_id=6001 preco_stop=129700 preco_limite=129600 preco_stop_anterior=129510
saude posicao=1
nada
